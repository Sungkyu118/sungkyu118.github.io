---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% comment %}
    Custom sitemap for GitHub Pages + Chirpy.
    - Use absolute_url to respect url/baseurl.
    - Keep the sitemap focused on indexable blog posts.
    - Exclude feeds, JSON, service workers, assets, archives, and pagination pages.
  {% endcomment %}

  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url | replace: 'index.html', '' }}</loc>
    {% if post.last_modified_at %}
    <lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>
    {% else %}
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
  {% endfor %}
</urlset>
